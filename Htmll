        <!-- ========================================== -->
        <section id="about" class="bg-parchmentCard rounded-2xl p-6 sm:p-10 shadow-md border border-ochre/30 space-y-8">
            <header class="border-b border-ochre/30 pb-4 flex items-center justify-between">
